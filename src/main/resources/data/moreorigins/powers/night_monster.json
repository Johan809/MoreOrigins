{
  "type": "origins:multiple",
  "golem_target": {
    "type": "origins:action_over_time",
    "interval": 20,
    "rising_action": {
      "type": "origins:execute_command",
      "command": "tag @s add moreorigins.night_monster"
    },
    "falling_action": {
      "type": "origins:execute_command",
      "command": "tag @s remove moreorigins.night_monster"
    },
    "condition": {
      "type": "origins:daytime",
      "inverted": true
    }
  },
  "clear_tag": {
    "type": "origins:action_on_callback",
    "entity_action_lost": {
      "type": "origins:execute_command",
      "command": "tag @s remove moreorigins.night_monster"
    }
  },
  "villager_fear": {
    "type": "origins:prevent_entity_use",
    "bientity_condition": {
      "type": "origins:target_condition",
      "condition": {
        "type": "origins:entity_type",
        "entity_type": "minecraft:villager"
      }
    },
    "condition": {
      "type": "origins:daytime",
      "inverted": true
    }
  },
  "name": "Night monster",
  "description": "At night, the villagers fear you and the golems attack you at first sight."
}
